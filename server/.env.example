# =================================================================
# AITOOLS — Production & Development Environment Configuration
# =================================================================

# Server Runtime Environment (production | development | test)
NODE_ENV=production

# Server Port
PORT=8080

# Client Allowed Origin for CORS Whitelist (e.g. production domain)
CLIENT_URL=http://localhost:3000

# MongoDB Production Connection String (Atlas, DocumentDB, or Self-Hosted Replica)
# In production, MONGODB_URL is mandatory and cannot be omitted.
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority

# JWT Authentication Secret Key (Minimum 32 random characters for HMAC SHA-256)
JWT_SECRET=your-production-jwt-secret-key-at-least-32-chars-long

# JWT Token Expiry
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3-Compatible Persistent Object Storage (Required in production for uploaded documents)
# In development, omission falls back to local filesystem storage in uploads/documents/.
S3_BUCKET_NAME=your-production-s3-bucket-name
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  # Optional: For Cloudflare R2 / MinIO / LocalStack
# S3_FORCE_PATH_STYLE=false                                # Optional: Set to true for MinIO/LocalStack

# Cloudinary Storage Configuration (Optional: for cloud image hosting)
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret
FOLDER_NAME=aitools_prod

# Hugging Face Access Token (Required in production for Image Generation, Embeddings & RAG LLM Chat)
# In development, omission activates local/public development fallback engines.
HF_TOKEN=your_huggingface_token

# RapidAPI Key (Required in production for Article Summarization & Translation APIs)
# In development, omission activates local/public development fallback engines.
RAPID_API_KEY=your_rapidapi_key
